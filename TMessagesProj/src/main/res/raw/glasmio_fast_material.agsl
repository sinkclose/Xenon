float2 nativeGlassSafeNormal(float2 v) {
    return v / max(length(v), 0.000001);
}
float3 nativeGlassRoundedField(float2 point, float2 halfExtent, float2 radii, float normalMix) {
    if (min(abs(radii.x), abs(radii.y)) <= 0.000001) {
        float2 edge = abs(point) - halfExtent;
        float2 signs = float2(point.x < 0.0 ? -1.0 : 1.0, point.y < 0.0 ? -1.0 : 1.0);
        float2 normal = signs * (edge.x > edge.y ? float2(1.0, 0.0) : float2(0.0, 1.0));
        float2 oval = nativeGlassSafeNormal(float2(point.x, point.y * halfExtent.x / max(halfExtent.y, 0.000001)));
        return float3(max(edge.x, edge.y), nativeGlassSafeNormal(mix(normal, oval, normalMix)));
    }
    float2 r = max(abs(radii), float2(0.001));
    float radius = min(r.x, r.y);
    float2 inverseAxis = radius / r;
    float2 local = point * inverseAxis;
    float2 extent = halfExtent * inverseAxis;
    float expandedRadius = radius * 1.5286649465560913;
    float2 curvature = clamp(2.8915570351735034 -
        1.4457785175867517 * (extent * 2.0) / expandedRadius, 0.0, 1.0);
    float baseRadius = mix(expandedRadius, radius, max(curvature.x, curvature.y));
    float2 edge = abs(local) - extent;
    float2 circle = edge + baseRadius;
    float interior = min(max(circle.x, circle.y), 0.0);
    float2 z = max((edge + expandedRadius) / expandedRadius, 0.0);
    float largest = max(z.x, z.y);
    float t = largest > 0.0 ? clamp(min(z.x, z.y) / largest, 0.0, 1.0) : 0.0;
    float d = length(z);
    float polynomial = ((((-0.926054 * t + 3.15601) * t - 3.64122) * t +
        1.26803) * t + 0.268531) * t * t;
    float raw = d + 1.0 - 1.0 / (1.0 - polynomial * clamp(d, 0.0, 1.0));
    float alternate = 0.3458344340324402 +
        0.6541655659675598 * length(max(1.5286649465560913 * z - 0.528665, 0.0));
    float weight = clamp((z.y > z.x ? 1.0 : -1.0) * (t - 1.0) + 0.5, 0.0, 1.0);
    float corrected = mix(mix(raw, alternate, curvature.x), mix(raw, alternate, curvature.y), weight);
    float distance = interior + expandedRadius * float(half(corrected - 1.0));
    float2 positiveNormal = nativeGlassSafeNormal(max(circle, 0.0));
    if (positiveNormal.x + positiveNormal.y <= 0.0)
        positiveNormal = circle.x > circle.y ? float2(1.0, 0.0) : float2(0.0, 1.0);
    float2 normal = positiveNormal * float2(local.x < 0.0 ? -1.0 : 1.0, local.y < 0.0 ? -1.0 : 1.0);
    float2 oval = nativeGlassSafeNormal(float2(local.x, local.y * extent.x / max(extent.y, 0.000001)));
    normal = nativeGlassSafeNormal(mix(normal, oval, normalMix));
    // The native field transforms this normalized gradient without a second normalization.
    return float3(distance, normal * inverseAxis);
}

uniform float2 size;
uniform float4 cornerRadii;
float radiusAt(float2 p) {
    return p.y < size.y * 0.5
        ? (p.x < size.x * 0.5 ? cornerRadii.x : cornerRadii.y)
        : (p.x < size.x * 0.5 ? cornerRadii.w : cornerRadii.z);
}
float3 glassField(float2 p, float normalMix) {
    return nativeGlassRoundedField(p - size * 0.5, size * 0.5, float2(radiusAt(p)), normalMix);
}
float glassDistance(float2 p) { return glassField(p, 0.0).x; }
float2 glassNormal(float2 p) { return glassField(p, 0.0).yz; }
float2 glassDepthNormal(float2 p, float normalMix) { return glassField(p, normalMix).yz; }

float glassExtendedSrgbEncodeChannel(float value) {
    float magnitude = abs(value);
    float encoded = magnitude <= 0.0031308
        ? 12.92 * magnitude
        : 1.055 * pow(magnitude, 1.0 / 2.4) - 0.055;
    return sign(value) * encoded;
}
float glassExtendedSrgbDecodeChannel(float value) {
    float magnitude = abs(value);
    float decoded = magnitude <= 0.04045
        ? magnitude / 12.92
        : pow((magnitude + 0.055) / 1.055, 2.4);
    return sign(value) * decoded;
}
float3 glassLinearToNativeGamma(float3 value) {
    return float3(glassExtendedSrgbEncodeChannel(value.r),
        glassExtendedSrgbEncodeChannel(value.g), glassExtendedSrgbEncodeChannel(value.b));
}
float3 glassNativeGammaToLinear(float3 value) {
    return float3(glassExtendedSrgbDecodeChannel(value.r),
        glassExtendedSrgbDecodeChannel(value.g), glassExtendedSrgbDecodeChannel(value.b));
}
float3 glassWorkingToNativeGamma(float3 straightWorkingRgb) {
    return glassLinearToNativeGamma(toLinearSrgb(straightWorkingRgb));
}
float3 glassNativeGammaToWorking(float3 straightNativeRgb) {
    return fromLinearSrgb(glassNativeGammaToLinear(straightNativeRgb));
}
float4 glassWorkingToNativeGammaPremul(float4 value) {
    return float4(glassWorkingToNativeGamma(value.rgb / max(value.a, .000001)) * value.a, value.a);
}
float4 glassNativeGammaToWorkingPremul(float4 value) {
    return float4(glassNativeGammaToWorking(value.rgb / max(value.a, .000001)) * value.a, value.a);
}

uniform shader content;
uniform float2 inputSize;
uniform float4 mainPlane;
uniform float4 fillPlane;
uniform float2 planeScales;
uniform float2 planeVariance;
float4 nativeAtlasBilinear(float2 p, int level) {
    return glassWorkingToNativeGammaPremul(float4(content.eval(clamp(p, float2(.5), inputSize - .5))));
}
float4 gaussianSample(float2 p, float4 rect, float scale) {
    return glassWorkingToNativeGammaPremul(float4(content.eval(rect.xy + clamp(p * scale, float2(.5), rect.zw - .5))));
}
float nativeVariance(float lod) {
    float level = clamp(lod, 0.0, 20.0);
    float a = exp2(2.0 * floor(level));
    return 4.0078125 / 3.0 * (mix(a, a * 4.0, fract(level)) - 1.0);
}
float4 nativeAtlasSample(float2 p, float lod) {
    float variance = nativeVariance(lod);
    if (variance <= .00001 || planeVariance.x <= .00001) return nativeAtlasBilinear(p, 0);
    if (variance <= planeVariance.x) {
        float4 main = gaussianSample(p, mainPlane, planeScales.x);
        if (variance >= planeVariance.x * .9999) return main;
        return mix(nativeAtlasBilinear(p, 0), main, variance / planeVariance.x);
    }
    float4 fill = gaussianSample(p, fillPlane, planeScales.y);
    if (variance >= planeVariance.y * .9999) return fill;
    return mix(gaussianSample(p, mainPlane, planeScales.x), fill,
        clamp((variance - planeVariance.x) / max(.00001, planeVariance.y - planeVariance.x), 0.0, 1.0));
}
float nativeGlassLod(float radius) {
    float r = max(radius, 0.0) * 1.6;
    return log2(r < 2.0 ? 1.0 + r * .5 : r);
}
float4 nativeAtlasEncode(float4 value) { return glassNativeGammaToWorkingPremul(value); }
float4 nativeAtlasEncodeRelative(float4 relative, float4 backdrop) {
    if (relative.a == 1.0) return nativeAtlasEncode(relative);
    float4 actual = nativeAtlasEncode(relative + backdrop * (1.0 - relative.a));
    float4 original = nativeAtlasEncode(backdrop);
    return float4(actual.rgb - original.rgb * (1.0 - relative.a), relative.a);
}

float nativeGaussianTail(float value) {
    float x = clamp(value, -2.0, 2.0);
    float q = x * x;
    return (((0.00295448 * q - 0.03445430) * q + 0.168213) * q - 0.560546) * x + 0.5;
}
float nativeHighlightStrip(float depth, float height, float curvature, float aa) {
    float u = clamp(depth / max(height, 0.000001), 0.0, 1.0);
    float profile = mix(u < 1.0 ? 1.0 : 0.0, 1.0 - u, curvature);
    return profile * clamp(depth / aa + 0.5, 0.0, 1.0)
        * clamp((height - depth) / aa + 0.5, 0.0, 1.0);
}
float nativeHighlightAngular(float alignment, float threshold) {
    return clamp((alignment - threshold) / max(1.0 - threshold, 0.000001), 0.0, 1.0);
}
float nativeHighlightBias(float coverage, float bias) {
    return coverage / max(1.0 + bias * (1.0 - coverage), 0.000001);
}
float nativeGlassShapeCoverage(float3 field, float shapeAlpha) {
    float aa = max(abs(field.y) + abs(field.z), 0.0001);
    return clamp(.5 - field.x / aa, 0.0, 1.0) * shapeAlpha;
}
float nativeGlassStrokeKeyFill(float3 field, float density, float shapeAlpha, float threshold) {
    float aa = max(abs(field.y) + abs(field.z), .0001);
    float coverage = nativeGlassShapeCoverage(field, shapeAlpha);
    float height = .5333333333333333 * density;
    // Captured height + offset == 0 and offset < 0 selects stroke_mode in the CPU builder.
    float strip = (1.0 - coverage) * clamp((height - field.x) / aa + .5, 0.0, 1.0) * shapeAlpha;
    float key = strip * nativeHighlightAngular(field.y, threshold);
    float fill = strip * nativeHighlightAngular(-field.y, threshold);
    return nativeHighlightBias(key, .5) + nativeHighlightBias(fill, .5);
}
float nativeGlassRingCoverage(float shiftedDistance, float coverage, float density, float clear) {
    float a = shiftedDistance / (5.0 * density) * .7071067811865476;
    float b = (shiftedDistance + 4.0 * density) / (5.0 * density) * .7071067811865476;
    return clamp(nativeGaussianTail(a) - nativeGaussianTail(b), 0.0, 1.0)
        * .06 * (1.0 - clear) * coverage;
}
float4 nativeGlassBackgroundCompletion(float4 coveredFace, float3 original, float3 originalFace,
    float keyFill, float faceOpacity, float colorBias) {
    if (keyFill <= .000001) return coveredFace;
    float alpha = coveredFace.a;
    float3 color = coveredFace.rgb;
    if (alpha < 1.0) {
        float3 corrected = colorBias < 0.0 ? min(originalFace, original) : max(originalFace, original);
        float3 completion = mix(original, corrected, faceOpacity * keyFill);
        color += (1.0 - alpha) * completion;
    }
    color *= 1.0 + colorBias * keyFill * (3.0 - 2.0 * color);
    float extendedAlpha = alpha + (1.0 - alpha) * keyFill;
    if (alpha < 1.0) color -= (1.0 - extendedAlpha) * original;
    // Backdrop-relative RGB may be signed. Coverage and completion must not clamp it.
    return float4(color, extendedAlpha);
}

float nativeCasdfHighlightCoverage(float signedDistance, float2 gradient,
    float height, float angle, float curvature) {
    float depth = -signedDistance;
    if (depth < -5.0) return 0.0;
    float2 normal = normalize(gradient);
    float aa = max(abs(normal.x) + abs(normal.y), 0.0001);
    float alignment = dot(normal, float2(sin(angle), -cos(angle)));
    float direct = nativeHighlightStrip(depth, height, curvature, aa);
    float diffuse = nativeHighlightStrip(depth, height * 8.0, 1.0, aa);
    float spread = cos(1.3962634015954636);
    float diffuseSpread = cos(1.3962634015954636 * 0.65);
    float key = direct * nativeHighlightAngular(alignment, spread);
    float fill = direct * nativeHighlightAngular(-alignment, spread);
    float diffuseKey = diffuse * nativeHighlightAngular(alignment, diffuseSpread);
    float diffuseFill = diffuse * nativeHighlightAngular(-alignment, diffuseSpread);
    return key + fill + nativeHighlightBias(diffuseKey, 11.333333333333334)
        + nativeHighlightBias(diffuseFill, 11.333333333333334);
}

float4 nativeVibrantColorMatrixApply(float4 mask, float4 sampledBackdrop,
    float4 row0, float4 row1, float4 row2, float4 row3, float4 bias, float2 clampParameters) {
    float4 inputColor = float4(sampledBackdrop.rgb / max(sampledBackdrop.a, 0.000001), sampledBackdrop.a);
    float4 transformed = float4(dot(row0, inputColor), dot(row1, inputColor),
        dot(row2, inputColor), dot(row3, inputColor)) + bias;
    float matrixAlpha = clamp(transformed.a, 0.0, 1.0);
    float4 result = float4(transformed.rgb * matrixAlpha, matrixAlpha) * mask.a;
    if (clampParameters.x > 0.0) {
        float3 straight = result.rgb / max(result.a, 0.000001);
        if (clampParameters.y > 0.0) {
            float maximum = max(max(straight.r, straight.g), straight.b);
            if (maximum > clampParameters.x) straight *= clampParameters.x / maximum;
        } else {
            straight = clamp(straight, float3(-0.75), float3(clampParameters.x));
        }
        result.rgb = straight * result.a;
    }
    return result;
}
float4 nativeVibrantColorMatrixApplyOver(float4 mask, float4 sampledBackdrop, float4 destination,
    float4 row0, float4 row1, float4 row2, float4 row3, float4 bias, float2 clampParameters) {
    float4 source = nativeVibrantColorMatrixApply(mask, sampledBackdrop,
        row0, row1, row2, row3, bias, clampParameters);
    return source + destination * (1.0 - source.a);
}

uniform float4 nativeVibrantRow0;
uniform float4 nativeVibrantRow1;
uniform float4 nativeVibrantRow2;
uniform float4 nativeVibrantRow3;
uniform float4 nativeVibrantBias;
uniform float2 nativeVibrantClamp;
float4 nativeVibrantColorMatrix(float4 mask, float4 sampledBackdrop) {
    return nativeVibrantColorMatrixApply(mask, sampledBackdrop,
        nativeVibrantRow0, nativeVibrantRow1, nativeVibrantRow2, nativeVibrantRow3,
        nativeVibrantBias, nativeVibrantClamp);
}
float4 nativeVibrantColorMatrixOver(float4 mask, float4 sampledBackdrop, float4 destination) {
    return nativeVibrantColorMatrixApplyOver(mask, sampledBackdrop, destination,
        nativeVibrantRow0, nativeVibrantRow1, nativeVibrantRow2, nativeVibrantRow3,
        nativeVibrantBias, nativeVibrantClamp);
}

uniform float materialAppearanceMix;
uniform float materialOpacity;
uniform float4 face;
uniform float4 faceFill;
uniform float luminanceRollOff;
uniform float fillCount;
uniform float4 fill0;
uniform float4 fill1;
uniform float4 fill2;
uniform float4 fill3;
uniform float4 fillModes;
uniform float hasTint;
uniform float4 tintRow0;
uniform float4 tintRow1;
uniform float4 tintRow2;
uniform float4 overlay;

half4 navigationWorkingToNative(half4 value) {
    float alpha = float(value.a);
    return half4(glassWorkingToNativeGamma(float3(value.rgb) / max(alpha, .000001)) * alpha, alpha);
}
half4 navigationNativeToWorking(half4 value) {
    float alpha = float(value.a);
    return half4(glassNativeGammaToWorking(float3(value.rgb) / max(alpha, .000001)) * alpha, alpha);
}
float materialLum(float3 color) { return dot(color, float3(.2126, .7152, .0722)); }
float3 materialClip(float3 color) {
    float luminance = dot(color, float3(.3, .59, .11));
    float lowest = min(min(color.r, color.g), color.b);
    float highest = max(max(color.r, color.g), color.b);
    if (lowest < 0.0) color = luminance + (color - luminance) * luminance / max(luminance - lowest, .00001);
    if (highest > 1.0) color = luminance + (color - luminance) * (1.0 - luminance) / max(highest - luminance, .00001);
    return color;
}
float3 materialFill(float3 color, float4 paint, float mode) {
    if (mode < .5) return mix(color, paint.rgb, paint.a);
    if (mode < 1.5) return min(color + paint.rgb * paint.a, 1.0);
    if (mode < 2.5) {
        float sourceLum = dot(paint.rgb, float3(.3, .59, .11));
        float targetLum = dot(color, float3(.3, .59, .11));
        return mix(color, materialClip(color + sourceLum - targetLum), paint.a);
    }
    if (mode < 3.5) return mix(color, max(color, paint.rgb), paint.a);
    return mix(color, min(color, paint.rgb), paint.a);
}
// The native optical kernel keeps outer-ray RGB and alpha independent at this boundary.
float4 endpoint_navigationMaterialFaceRaw(float4 sampled) {
    if (materialOpacity <= 0.0) return sampled;
    float3 color = sampled.rgb;
    if (face.w > .5) {
        // QuartzCore AIR: attenuate luma and compensate chroma before the face matrix.
        // The quadratic gray response is only the neutral-color specialization of this path.
        float luminance = materialLum(color);
        if (luminanceRollOff > 0.0) {
            float gain = clamp(1.0 - luminance * luminanceRollOff, 0.0, 1.0);
            color = mix(float3(luminance * gain), color * gain, 1.0 + .3 * (1.0 - gain));
            luminance = materialLum(color);
        }
        color = (luminance * (face.z - face.y) + face.y) + (color - luminance) * face.x;
        color = mix(color, faceFill.rgb, faceFill.a);
    }
    if (fillCount > .5) color = materialFill(color, fill0, fillModes.x);
    if (fillCount > 1.5) color = materialFill(color, fill1, fillModes.y);
    if (fillCount > 2.5) color = materialFill(color, fill2, fillModes.z);
    if (fillCount > 3.5) color = materialFill(color, fill3, fillModes.w);
    return float4(color, sampled.a);
}
half4 endpoint_navigationMaterialFace(half4 sampled) {
    if (materialOpacity <= 0.0) return sampled;
    float alpha = float(sampled.a);
    float4 faceResult = endpoint_navigationMaterialFaceRaw(float4(float3(sampled.rgb) / max(alpha, .00001), alpha));
    float resultAlpha = max(alpha, faceFill.a);
    return half4(faceResult.rgb * resultAlpha, resultAlpha);
}
half4 endpoint_navigationMaterialFinish(half4 sampled, half4 faceResult) {
    if (materialOpacity <= 0.0) return sampled;
    float resultAlpha = float(faceResult.a);
    float3 color = float3(faceResult.rgb) / max(resultAlpha, .00001);
    if (hasTint > .5) {
        float4 backdrop = float4(color, 1.0);
        color = float3(dot(tintRow0, backdrop), dot(tintRow1, backdrop), dot(tintRow2, backdrop));
    }
    color = mix(color, overlay.rgb, overlay.a);
    if (hasTint > .5) resultAlpha = 1.0;
    if (face.w < .5) color = clamp(color, 0.0, 1.0);
    half4 result = half4(color * resultAlpha, resultAlpha);
    return mix(sampled, result, materialOpacity);
}
half4 endpoint_navigationMaterial(half4 sampled) {
    return endpoint_navigationMaterialFinish(sampled, endpoint_navigationMaterialFace(sampled));
}


uniform float2 outputSize;
uniform float2 glassOrigin;
uniform float density;
uniform float darkMode;
uniform float edgeOpacity;
uniform float topHighlight;
uniform float lightAngle;
uniform float textureScale;
uniform float2 shadowProfile;
uniform float4 visibleBounds;
uniform float4 glassTint;
float3 navigationGlassField(float2 p) { return glassField(p, 0.0); }

float nativeGlassDisplacement(float signedDistance, float inverseHeight, float signedAmount) {
    float u = clamp(-signedDistance * inverseHeight, 0.0, 1.0);
    return signedAmount * (1.0 - clamp(sqrt(u * (2.0 - u)), 0.0, 1.0));
}
float2 nativeGlassDisplacementNormal(float2 gradient, float4 displacementMatrix) {
    return float2(dot(gradient, displacementMatrix.xy), dot(gradient, displacementMatrix.zw));
}
float nativeGlassRefractionWeight(float signedDistance, float threshold0, float threshold1, float opacity) {
    float width = threshold1 - threshold0;
    float progress = width != 0.0 ? clamp((signedDistance - threshold0) / width, 0.0, 1.0)
        : step(threshold1, signedDistance);
    return opacity * progress;
}
float2 nativeGlassAberrationNormal(float2 gradient, float4 matrix, float2 direction) {
    return float2(
        dot(float2(dot(matrix.zw, direction), direction.x * matrix.w - direction.y * matrix.z), gradient),
        dot(float2(dot(matrix.xy, direction), direction.x * matrix.y - direction.y * matrix.x), gradient)
    );
}

uniform float recipeOpacity;
uniform float2 captureOrigin;
uniform float pointScale;
uniform float2 nativeAtlasRadii;
uniform float3 nativeAtlasBlurParameters;
uniform float4 nativeAtlasLensParameters;
uniform float3 nativeAtlasFillWeights;
uniform float nativeAtlasOuterOpacity;
float3 nativeAtlasFlush(float3 color) {
    return float3(abs(color.r) < .000001 ? 0.0 : color.r,
        abs(color.g) < .000001 ? 0.0 : color.g, abs(color.b) < .000001 ? 0.0 : color.b);
}
float nativeAtlasBlurOpacity(float distance) {
    float d = distance / max(pointScale, .00001);
    return d < -1.0 ? mix(nativeAtlasBlurParameters.y, nativeAtlasBlurParameters.z,
        clamp((d - nativeAtlasBlurParameters.x) / max(-1.0 - nativeAtlasBlurParameters.x, .00001), 0.0, 1.0))
        : (d < 0.0 ? mix(nativeAtlasBlurParameters.z, .5, d + 1.0) : 1.0);
}
float4 nativeAtlasRay(float2 coordinate, float3 field, bool outer) {
    float inverseHeight = outer ? nativeAtlasLensParameters.z : nativeAtlasLensParameters.x;
    float amount = outer ? nativeAtlasLensParameters.w : nativeAtlasLensParameters.y;
    float displacement = nativeGlassDisplacement(field.x, inverseHeight, amount);
    float lod = nativeGlassLod(nativeAtlasRadii.x * nativeAtlasBlurOpacity(field.x + displacement));
    return nativeAtlasSample(coordinate + field.yz * displacement, lod);
}
float4 nativeAtlasFiltered(float2 coordinate, float3 field) {
    float4 inner = nativeAtlasRay(coordinate, field, false);
    // AIR first combines the mip samples, then removes source alpha once for the face.
    float3 color = nativeAtlasFlush(inner.rgb / max(inner.a, .000001));
    if (nativeAtlasRadii.y > 0.0 && nativeAtlasFillWeights.z > 0.0) {
        float lod = nativeGlassLod(nativeAtlasRadii.y);
        float offset = lod * .25;
        float4 sampledFill = (nativeAtlasSample(coordinate - offset, lod)
            + nativeAtlasSample(coordinate + offset, lod)) * .5;
        float3 fill = nativeAtlasFlush(sampledFill.rgb / max(sampledFill.a, .000001));
        color = nativeAtlasFillWeights.x * min(color, fill) + nativeAtlasFillWeights.y * max(color, fill)
            + (1.0 - nativeAtlasFillWeights.x - nativeAtlasFillWeights.y) * color;
        color = mix(color, fill, nativeAtlasFillWeights.z);
    }
    float4 result = float4(color, 1.0);
    if (nativeAtlasOuterOpacity > 0.0) {
        float opacity = nativeGlassRefractionWeight(field.x, -pointScale, 0.0, nativeAtlasOuterOpacity);
        if (opacity > 0.0) {
            float4 outer = nativeAtlasRay(coordinate, field, true);
            outer.rgb = nativeAtlasFlush(outer.rgb);
            // The recovered outer sample remains raw RGBA. This is a four-channel mix, not SrcOver.
            result = mix(result, outer, opacity);
        }
    }
    // Native face processing consumes this mixed RGB directly and retains its raw alpha.
    // Do not force the outer sample opaque or unpremultiply it here.
    if (recipeOpacity < 1.0) {
        float displacement = nativeGlassDisplacement(field.x, nativeAtlasLensParameters.x, nativeAtlasLensParameters.y);
        float4 sharp = nativeAtlasSample(coordinate + field.yz * displacement, 0.0);
        sharp = float4(nativeAtlasFlush(sharp.rgb / max(sharp.a, .000001)), 1.0);
        result = mix(sharp, result, recipeOpacity);
    }
    return result;
}

half4 main(float2 coordinate) {
    if (coordinate.x < 0.0 || coordinate.y < 0.0 || coordinate.x >= outputSize.x || coordinate.y >= outputSize.y) return half4(0.0);
    float guard = max(2.0 * shadowProfile.x, 2.0) * density;
    if (coordinate.x < visibleBounds.x - guard || coordinate.x > visibleBounds.z + guard
        || coordinate.y < visibleBounds.y - guard || coordinate.y > visibleBounds.w + guard + 8.0 * density) return half4(0.0);
    float2 p = coordinate - glassOrigin;
    float3 field = glassField(p, 0.0);
    float coverage = nativeGlassShapeCoverage(field, 1.0);
    float threshold = cos(mix(1.8500490071139892, 1.3089969389957472, darkMode));
    float key = nativeGlassStrokeKeyFill(field, density, 1.0, threshold) * edgeOpacity;
    float shifted = glassField(p - float2(0.0, 8.0 * density), 0.0).x;
    float ring = nativeGlassRingCoverage(shifted, coverage, density, 0.0) * edgeOpacity;
    float shadowRadius = max(shadowProfile.x * density, .0001);
    float shadowAlpha = shifted > 2.0 * shadowRadius ? 0.0
        : nativeGaussianTail(shifted / shadowRadius) * shadowProfile.y;
    // The optical pipeline is unreachable outside the material and its shadow.
    if (coverage <= 0.0 && key <= .000001 && ring <= .000001 && shadowAlpha <= .000001) return half4(0.0);
    float2 texturePoint = coordinate * textureScale;
    float4 originalRaw = nativeAtlasBilinear(texturePoint, 0);
    float3 original = nativeAtlasFlush(originalRaw.rgb / max(originalRaw.a, .000001));
    float4 filtered = coverage > 0.0
        ? nativeAtlasFiltered(texturePoint, float3(field.x * textureScale, field.yz)) : float4(original, 1.0);
    float4 faceResult = endpoint_navigationMaterialFaceRaw(filtered);
    faceResult.rgb = faceResult.rgb * (1.0 - glassTint.a) + glassTint.rgb;
    float4 shadowResult = float4(original * .7 * shadowAlpha, shadowAlpha);
    float4 covered = mix(shadowResult, faceResult, coverage);
    covered.rgb *= 1.0 - ring;
    covered.a = covered.a * (1.0 - ring) + ring;
    float3 originalFace = endpoint_navigationMaterialFaceRaw(float4(original, 1.0)).rgb;
    float4 completed = nativeGlassBackgroundCompletion(covered, original, originalFace, key, 1.0, -.3);
    float highlightMask = nativeCasdfHighlightCoverage(field.x, field.yz, density, lightAngle, .75) * topHighlight;
    if (highlightMask > 0.0) {
        float4 actual = float4(completed.rgb + (1.0 - completed.a) * original, 1.0);
        float4 light = nativeVibrantColorMatrix(float4(0.0, 0.0, 0.0, highlightMask), actual);
        completed = light + completed * (1.0 - light.a);
    }
    return half4(nativeAtlasEncodeRelative(completed, originalRaw));
}
