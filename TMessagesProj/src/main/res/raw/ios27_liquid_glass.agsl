uniform shader img;
uniform float2 resolution;

uniform float2 size;
uniform float2 center;
uniform float4 radius;
uniform float refractionHeight;
uniform float refractionAmount;
uniform float depthEffect;
uniform float chromaticAberration;
uniform float darkMode;
uniform float pixelScale;
uniform float4 lensParams;
uniform float lightIntensity;
uniform float lightAngle;
uniform float4 glassTint;
uniform float clearControl;
uniform float lightFalloff;
uniform float solidGlare;
uniform float backdropBlur;
uniform float blurMix;

half4 sampleBackdrop(float2 coord) {
    return img.eval(clamp(coord, float2(0.5), resolution - float2(0.5)));
}

// NOTE: blur is no longer done inside the shader.
// RenderEffect.createBlurEffect() on the source RenderNode provides a proper
// hardware-accelerated separable Gaussian before the shader ever sees the
// pixels. This removes the broken-glass artifact that multi-tap in-shader
// sampling produced and eliminates the per-pixel texture-read explosion that
// was caused by calling the blur helper inside the chromatic-dispersion loop.

float radiusAt(float2 coord, float4 radii) {
    if (coord.x >= 0.0) {
        if (coord.y <= 0.0) return radii.y;
        else return radii.z;
    } else {
        if (coord.y <= 0.0) return radii.x;
        else return radii.w;
    }
}

float rayDisplacement(float sd, float depth, float amount) {
    if (depth <= 0.0 || sd <= -depth) return 0.0;
    float u = clamp(-sd / depth, 0.0, 1.0);
    return amount * (1.0 - sqrt(u * (2.0 - u)));
}

// ROUNDED_FIELD

// MENU_FIELD

float3 glassField(float2 coord) {
    float2 local = coord - center;
    float2 extent = size * 0.5;
    float r = radiusAt(local, radius);
    return nativeGlassRoundedField(local, extent, float2(r), 0.0); // MENU_DISTANCE
}

// BLUR_PLANE

half4 sampleRay(float2 refractedCoord, float2 dispersedCoord, float blurWeight) {
    half4 baseColor = sampleOpticalBackdrop(refractedCoord, blurWeight);
    if (dot(dispersedCoord, dispersedCoord) <= 0.000001) return baseColor;

    half4 color = half4(0.0);

    half4 red = sampleOpticalBackdrop(refractedCoord + dispersedCoord, blurWeight);
    color.r += red.r / 3.5;
    color.a += red.a / 7.0;

    half4 orange = sampleOpticalBackdrop(refractedCoord + dispersedCoord * (2.0 / 3.0), blurWeight);
    color.r += orange.r / 3.5;
    color.g += orange.g / 7.0;
    color.a += orange.a / 7.0;

    half4 yellow = sampleOpticalBackdrop(refractedCoord + dispersedCoord * (1.0 / 3.0), blurWeight);
    color.r += yellow.r / 3.5;
    color.g += yellow.g / 3.5;
    color.a += yellow.a / 7.0;

    half4 green = baseColor;
    color.g += green.g / 3.5;
    color.a += green.a / 7.0;

    half4 cyan = sampleOpticalBackdrop(refractedCoord - dispersedCoord * (1.0 / 3.0), blurWeight);
    color.g += cyan.g / 3.5;
    color.b += cyan.b / 3.0;
    color.a += cyan.a / 7.0;

    half4 blue = sampleOpticalBackdrop(refractedCoord - dispersedCoord * (2.0 / 3.0), blurWeight);
    color.b += blue.b / 3.0;
    color.a += blue.a / 7.0;

    half4 purple = sampleOpticalBackdrop(refractedCoord - dispersedCoord, blurWeight);
    color.r += purple.r / 7.0;
    color.b += purple.b / 3.0;
    color.a += purple.a / 7.0;

    return color;
}

half4 opticalColor(float2 coord, float3 field) {
    float sd = field.x;
    float2 halfSize = size * 0.5;
    float innerDepth = min(lensParams.y, min(halfSize.x, halfSize.y));
    float innerDistance = rayDisplacement(sd, innerDepth, lensParams.x);
    float2 inner = field.yz * innerDistance;
    float2 local = clamp((coord - center) / max(halfSize, float2(1.0)), -1.0, 1.0);
    float spread = chromaticAberration * local.x * local.y;
    float halfExtent = min(halfSize.x, halfSize.y);
    half4 c = sampleRay(coord + inner, inner * spread, opticalBlurWeight(sd, innerDistance, halfExtent));
    if (backdropBlur > 0.5) c = mixOpticalFill(c, sampleBlurredBackdrop(coord), darkMode);
    if (lensParams.z > 0.0 && sd > -pixelScale) {
        float outerDistance = rayDisplacement(sd, lensParams.w, lensParams.z);
        float2 outer = field.yz * outerDistance;
        float weight = 0.6 * clamp(1.0 + sd / max(pixelScale, 0.001), 0.0, 1.0);
        c = mix(c, sampleRay(coord + outer, outer * spread, opticalBlurWeight(sd, outerDistance, halfExtent)), half(weight));
    }
    if (backdropBlur > 0.5 && blurMix >= 0.0 && blurMix < 1.0) {
        c = mix(sampleBackdrop(coord + inner), c, half(blurMix));
    }
    // Keep capture gaps from turning refraction into a second translucent image.
    if (c.a < 0.999 && dot(inner, inner) > 0.000001) {
        c += sampleBackdrop(coord) * half(1.0 - c.a);
    }
    return c;
}

// PRESS_EFFECT

half4 renderGlass(float2 coord) {
    if (coord.x >= resolution.x || coord.y >= resolution.y) return half4(0.0);
    float3 field = glassField(coord);
    float coverage = opticalShapeCoverage(field);
    float extent = min(size.x, size.y);
    if (clearControl > 0.5) {
        if (field.x > 2.0) return half4(0.0);
        half4 c = opticalColor(coord, field);
        half3 rgb = c.a > 0.0001 ? c.rgb / c.a : half3(0.0);
        rgb = applyOpticalRim(rgb, field, lightAngle, lightIntensity, lightFalloff, solidGlare);
        return half4(rgb * c.a, c.a);
    }
    float key = opticalSideStroke(field, coverage, darkMode, lightIntensity);
    if (coverage <= 0.0) {
        return completeOpticalSideStroke(half4(0.0), coord, key, darkMode, extent);
    }
    half4 c = opticalColor(coord, field);
    half3 rgb = c.a > 0.0001 ? c.rgb / c.a : half3(0.0);
    rgb = opticalFace(rgb, darkMode, extent);
    rgb = rgb * half(1.0 - glassTint.a) + half3(glassTint.rgb);
    rgb = applyOpticalRim(rgb, field, lightAngle, lightIntensity, lightFalloff, solidGlare);
    half4 body = half4(rgb * c.a, c.a) * half(coverage);
    return completeOpticalSideStroke(body, coord, key, darkMode, extent);
}


half4 main(float2 coord) {
    half4 color = renderGlass(coord);
    return applyGlassPress(color, coord); // PRESS_APPLY
}
