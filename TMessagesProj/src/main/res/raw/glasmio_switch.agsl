float2 nativeGlassSafeNormal(float2 v) {
    return v / max(length(v), 0.000001);
}
float3 nativeGlassRoundedField(float2 point, float2 halfExtent, float2 radii, float normalMix) {
    if (min(abs(radii.x), abs(radii.y)) <= 0.000001) {
        float2 edge = abs(point) - halfExtent;
        float2 signs = float2(point.x < 0.0 ? -1.0 : 1.0, point.y < 0.0 ? -1.0 : 1.0);
        float2 normal = signs * (edge.x > edge.y ? float2(1.0, 0.0) : float2(0.0, 1.0));
        float2 oval = nativeGlassSafeNormal(float2(point.x, point.y * halfExtent.x / max(halfExtent.y, 0.000001)));
        return float3(max(edge.x, edge.y), nativeGlassSafeNormal(mix(normal, oval, normalMix)));
    }
    float2 r = max(abs(radii), float2(0.001));
    float radius = min(r.x, r.y);
    float2 inverseAxis = radius / r;
    float2 local = point * inverseAxis;
    float2 extent = halfExtent * inverseAxis;
    float expandedRadius = radius * 1.5286649465560913;
    float2 curvature = clamp(2.8915570351735034 -
        1.4457785175867517 * (extent * 2.0) / expandedRadius, 0.0, 1.0);
    float baseRadius = mix(expandedRadius, radius, max(curvature.x, curvature.y));
    float2 edge = abs(local) - extent;
    float2 circle = edge + baseRadius;
    float interior = min(max(circle.x, circle.y), 0.0);
    float2 z = max((edge + expandedRadius) / expandedRadius, 0.0);
    float largest = max(z.x, z.y);
    float t = largest > 0.0 ? clamp(min(z.x, z.y) / largest, 0.0, 1.0) : 0.0;
    float d = length(z);
    float polynomial = ((((-0.926054 * t + 3.15601) * t - 3.64122) * t +
        1.26803) * t + 0.268531) * t * t;
    float raw = d + 1.0 - 1.0 / (1.0 - polynomial * clamp(d, 0.0, 1.0));
    float alternate = 0.3458344340324402 +
        0.6541655659675598 * length(max(1.5286649465560913 * z - 0.528665, 0.0));
    float weight = clamp((z.y > z.x ? 1.0 : -1.0) * (t - 1.0) + 0.5, 0.0, 1.0);
    float corrected = mix(mix(raw, alternate, curvature.x), mix(raw, alternate, curvature.y), weight);
    float distance = interior + expandedRadius * float(half(corrected - 1.0));
    float2 positiveNormal = nativeGlassSafeNormal(max(circle, 0.0));
    if (positiveNormal.x + positiveNormal.y <= 0.0)
        positiveNormal = circle.x > circle.y ? float2(1.0, 0.0) : float2(0.0, 1.0);
    float2 normal = positiveNormal * float2(local.x < 0.0 ? -1.0 : 1.0, local.y < 0.0 ? -1.0 : 1.0);
    float2 oval = nativeGlassSafeNormal(float2(local.x, local.y * extent.x / max(extent.y, 0.000001)));
    normal = nativeGlassSafeNormal(mix(normal, oval, normalMix));
    // The native field transforms this normalized gradient without a second normalization.
    return float3(distance, normal * inverseAxis);
}

uniform float2 size;
uniform float4 cornerRadii;
float radiusAt(float2 p) {
    return p.y < size.y * 0.5
        ? (p.x < size.x * 0.5 ? cornerRadii.x : cornerRadii.y)
        : (p.x < size.x * 0.5 ? cornerRadii.w : cornerRadii.z);
}
float3 glassField(float2 p, float normalMix) {
    return nativeGlassRoundedField(p - size * 0.5, size * 0.5, float2(radiusAt(p)), normalMix);
}
float glassDistance(float2 p) { return glassField(p, 0.0).x; }
float2 glassNormal(float2 p) { return glassField(p, 0.0).yz; }
float2 glassDepthNormal(float2 p, float normalMix) { return glassField(p, normalMix).yz; }

float glassExtendedSrgbEncodeChannel(float value) {
    float magnitude = abs(value);
    float encoded = magnitude <= 0.0031308
        ? 12.92 * magnitude
        : 1.055 * pow(magnitude, 1.0 / 2.4) - 0.055;
    return sign(value) * encoded;
}
float glassExtendedSrgbDecodeChannel(float value) {
    float magnitude = abs(value);
    float decoded = magnitude <= 0.04045
        ? magnitude / 12.92
        : pow((magnitude + 0.055) / 1.055, 2.4);
    return sign(value) * decoded;
}
float3 glassLinearToNativeGamma(float3 value) {
    return float3(glassExtendedSrgbEncodeChannel(value.r),
        glassExtendedSrgbEncodeChannel(value.g), glassExtendedSrgbEncodeChannel(value.b));
}
float3 glassNativeGammaToLinear(float3 value) {
    return float3(glassExtendedSrgbDecodeChannel(value.r),
        glassExtendedSrgbDecodeChannel(value.g), glassExtendedSrgbDecodeChannel(value.b));
}
float3 glassWorkingToNativeGamma(float3 straightWorkingRgb) {
    return glassLinearToNativeGamma(toLinearSrgb(straightWorkingRgb));
}
float3 glassNativeGammaToWorking(float3 straightNativeRgb) {
    return fromLinearSrgb(glassNativeGammaToLinear(straightNativeRgb));
}
float4 glassWorkingToNativeGammaPremul(float4 value) {
    return float4(glassWorkingToNativeGamma(value.rgb / max(value.a, .000001)) * value.a, value.a);
}
float4 glassNativeGammaToWorkingPremul(float4 value) {
    return float4(glassNativeGammaToWorking(value.rgb / max(value.a, .000001)) * value.a, value.a);
}

uniform shader content;
uniform float2 nativeAtlasBaseSize;
uniform float4 nativeAtlasRects[8];
uniform float nativeAtlasLastLevel;
float4 nativeAtlasRect(int level) {
    if (level == 0) return nativeAtlasRects[0];
    if (level == 1) return nativeAtlasRects[1];
    if (level == 2) return nativeAtlasRects[2];
    if (level == 3) return nativeAtlasRects[3];
    if (level == 4) return nativeAtlasRects[4];
    if (level == 5) return nativeAtlasRects[5];
    if (level == 6) return nativeAtlasRects[6];
    return nativeAtlasRects[7];
}
float4 nativeAtlasTexel(float2 index, float4 rect) {
    float2 bounded = clamp(index, float2(0.0), rect.zw - 1.0);
    return glassWorkingToNativeGammaPremul(float4(content.eval(rect.xy + bounded + .5)));
}
float4 nativeAtlasBilinear(float2 coordinate, int level) {
    float4 rect = nativeAtlasRect(level);
    float2 pixel = clamp(coordinate / nativeAtlasBaseSize * rect.zw - .5, float2(0.0), rect.zw - 1.0);
    float2 index = floor(pixel);
    float2 t = pixel - index;
    return mix(mix(nativeAtlasTexel(index, rect), nativeAtlasTexel(index + float2(1.0, 0.0), rect), t.x),
        mix(nativeAtlasTexel(index + float2(0.0, 1.0), rect), nativeAtlasTexel(index + 1.0, rect), t.x), t.y);
}
float nativeGlassLod(float radius) {
    float scaledRadius = max(radius, 0.0) * 1.6;
    return max(log2(scaledRadius < 2.0 ? 1.0 + scaledRadius * .5 : scaledRadius), 0.0);
}
float4 nativeAtlasSample(float2 p, float lod) {
    float level = clamp(lod, 0.0, nativeAtlasLastLevel);
    int lo = int(floor(level));
    int hi = int(min(float(lo + 1), nativeAtlasLastLevel));
    float4 lower = nativeAtlasBilinear(p, lo);
    float fraction = fract(level);
    if (hi == lo || fraction == 0.0) return lower;
    return mix(lower, nativeAtlasBilinear(p, hi), fraction);
}
float4 nativeAtlasEncode(float4 value) { return glassNativeGammaToWorkingPremul(value); }
float4 nativeAtlasEncodeRelative(float4 relative, float4 backdrop) {
    if (relative.a == 1.0) return nativeAtlasEncode(relative);
    float4 actual = relative + backdrop * (1.0 - relative.a);
    float4 actualWorking = nativeAtlasEncode(actual);
    float4 backdropWorking = nativeAtlasEncode(backdrop);
    return float4(actualWorking.rgb - backdropWorking.rgb * (1.0 - relative.a), relative.a);
}

float nativeGlassDisplacement(float signedDistance, float inverseHeight, float signedAmount) {
    float u = clamp(-signedDistance * inverseHeight, 0.0, 1.0);
    return signedAmount * (1.0 - clamp(sqrt(u * (2.0 - u)), 0.0, 1.0));
}
float2 nativeGlassDisplacementNormal(float2 gradient, float4 displacementMatrix) {
    return float2(dot(gradient, displacementMatrix.xy), dot(gradient, displacementMatrix.zw));
}
float nativeGlassRefractionWeight(float signedDistance, float threshold0, float threshold1, float opacity) {
    float width = threshold1 - threshold0;
    float progress = width != 0.0 ? clamp((signedDistance - threshold0) / width, 0.0, 1.0)
        : step(threshold1, signedDistance);
    return opacity * progress;
}
float2 nativeGlassAberrationNormal(float2 gradient, float4 matrix, float2 direction) {
    return float2(
        dot(float2(dot(matrix.zw, direction), direction.x * matrix.w - direction.y * matrix.z), gradient),
        dot(float2(dot(matrix.xy, direction), direction.x * matrix.y - direction.y * matrix.x), gradient)
    );
}

float nativeGaussianTail(float value) {
    float x = clamp(value, -2.0, 2.0);
    float q = x * x;
    return (((0.00295448 * q - 0.03445430) * q + 0.168213) * q - 0.560546) * x + 0.5;
}
float nativeHighlightStrip(float depth, float height, float curvature, float aa) {
    float u = clamp(depth / max(height, 0.000001), 0.0, 1.0);
    float profile = mix(u < 1.0 ? 1.0 : 0.0, 1.0 - u, curvature);
    return profile * clamp(depth / aa + 0.5, 0.0, 1.0)
        * clamp((height - depth) / aa + 0.5, 0.0, 1.0);
}
float nativeHighlightAngular(float alignment, float threshold) {
    return clamp((alignment - threshold) / max(1.0 - threshold, 0.000001), 0.0, 1.0);
}
float nativeHighlightBias(float coverage, float bias) {
    return coverage / max(1.0 + bias * (1.0 - coverage), 0.000001);
}
float nativeGlassShapeCoverage(float3 field, float shapeAlpha) {
    float aa = max(abs(field.y) + abs(field.z), 0.0001);
    return clamp(.5 - field.x / aa, 0.0, 1.0) * shapeAlpha;
}
float nativeGlassStrokeKeyFill(float3 field, float density, float shapeAlpha, float threshold) {
    float aa = max(abs(field.y) + abs(field.z), .0001);
    float coverage = nativeGlassShapeCoverage(field, shapeAlpha);
    float height = .5333333333333333 * density;
    // Captured height + offset == 0 and offset < 0 selects stroke_mode in the CPU builder.
    float strip = (1.0 - coverage) * clamp((height - field.x) / aa + .5, 0.0, 1.0) * shapeAlpha;
    float key = strip * nativeHighlightAngular(field.y, threshold);
    float fill = strip * nativeHighlightAngular(-field.y, threshold);
    return nativeHighlightBias(key, .5) + nativeHighlightBias(fill, .5);
}
float nativeGlassRingCoverage(float shiftedDistance, float coverage, float density, float clear) {
    float a = shiftedDistance / (5.0 * density) * .7071067811865476;
    float b = (shiftedDistance + 4.0 * density) / (5.0 * density) * .7071067811865476;
    return clamp(nativeGaussianTail(a) - nativeGaussianTail(b), 0.0, 1.0)
        * .06 * (1.0 - clear) * coverage;
}
float4 nativeGlassBackgroundCompletion(float4 coveredFace, float3 original, float3 originalFace,
    float keyFill, float faceOpacity, float colorBias) {
    if (keyFill <= .000001) return coveredFace;
    float alpha = coveredFace.a;
    float3 color = coveredFace.rgb;
    if (alpha < 1.0) {
        float3 corrected = colorBias < 0.0 ? min(originalFace, original) : max(originalFace, original);
        float3 completion = mix(original, corrected, faceOpacity * keyFill);
        color += (1.0 - alpha) * completion;
    }
    color *= 1.0 + colorBias * keyFill * (3.0 - 2.0 * color);
    float extendedAlpha = alpha + (1.0 - alpha) * keyFill;
    if (alpha < 1.0) color -= (1.0 - extendedAlpha) * original;
    // Backdrop-relative RGB may be signed. Coverage and completion must not clamp it.
    return float4(color, extendedAlpha);
}

float nativeCasdfHighlightCoverage(float signedDistance, float2 gradient,
    float height, float angle, float curvature) {
    float depth = -signedDistance;
    if (depth < -5.0) return 0.0;
    float2 normal = normalize(gradient);
    float aa = max(abs(normal.x) + abs(normal.y), 0.0001);
    float alignment = dot(normal, float2(sin(angle), -cos(angle)));
    float direct = nativeHighlightStrip(depth, height, curvature, aa);
    float diffuse = nativeHighlightStrip(depth, height * 8.0, 1.0, aa);
    float spread = cos(1.3962634015954636);
    float diffuseSpread = cos(1.3962634015954636 * 0.65);
    float key = direct * nativeHighlightAngular(alignment, spread);
    float fill = direct * nativeHighlightAngular(-alignment, spread);
    float diffuseKey = diffuse * nativeHighlightAngular(alignment, diffuseSpread);
    float diffuseFill = diffuse * nativeHighlightAngular(-alignment, diffuseSpread);
    return key + fill + nativeHighlightBias(diffuseKey, 11.333333333333334)
        + nativeHighlightBias(diffuseFill, 11.333333333333334);
}

float4 nativeVibrantColorMatrixApply(float4 mask, float4 sampledBackdrop,
    float4 row0, float4 row1, float4 row2, float4 row3, float4 bias, float2 clampParameters) {
    float4 inputColor = float4(sampledBackdrop.rgb / max(sampledBackdrop.a, 0.000001), sampledBackdrop.a);
    float4 transformed = float4(dot(row0, inputColor), dot(row1, inputColor),
        dot(row2, inputColor), dot(row3, inputColor)) + bias;
    float matrixAlpha = clamp(transformed.a, 0.0, 1.0);
    float4 result = float4(transformed.rgb * matrixAlpha, matrixAlpha) * mask.a;
    if (clampParameters.x > 0.0) {
        float3 straight = result.rgb / max(result.a, 0.000001);
        if (clampParameters.y > 0.0) {
            float maximum = max(max(straight.r, straight.g), straight.b);
            if (maximum > clampParameters.x) straight *= clampParameters.x / maximum;
        } else {
            straight = clamp(straight, float3(-0.75), float3(clampParameters.x));
        }
        result.rgb = straight * result.a;
    }
    return result;
}
float4 nativeVibrantColorMatrixApplyOver(float4 mask, float4 sampledBackdrop, float4 destination,
    float4 row0, float4 row1, float4 row2, float4 row3, float4 bias, float2 clampParameters) {
    float4 source = nativeVibrantColorMatrixApply(mask, sampledBackdrop,
        row0, row1, row2, row3, bias, clampParameters);
    return source + destination * (1.0 - source.a);
}

uniform float4 nativeVibrantRow0;
uniform float4 nativeVibrantRow1;
uniform float4 nativeVibrantRow2;
uniform float4 nativeVibrantRow3;
uniform float4 nativeVibrantBias;
uniform float2 nativeVibrantClamp;
float4 nativeVibrantColorMatrix(float4 mask, float4 sampledBackdrop) {
    return nativeVibrantColorMatrixApply(mask, sampledBackdrop,
        nativeVibrantRow0, nativeVibrantRow1, nativeVibrantRow2, nativeVibrantRow3,
        nativeVibrantBias, nativeVibrantClamp);
}
float4 nativeVibrantColorMatrixOver(float4 mask, float4 sampledBackdrop, float4 destination) {
    return nativeVibrantColorMatrixApplyOver(mask, sampledBackdrop, destination,
        nativeVibrantRow0, nativeVibrantRow1, nativeVibrantRow2, nativeVibrantRow3,
        nativeVibrantBias, nativeVibrantClamp);
}

float4 nativeControlDisplacementMapForRaster(float4 field, float height, float curvature,
    float effectOffset, float maskOffset, float2 angle, float pixelScale) {
    float q = field.x + effectOffset;
    float depth = -q;
    float aa = max((abs(field.y) + abs(field.z)) * pixelScale, .0001);
    float maskDepth = depth - maskOffset;
    float coverage = maskDepth < -5.0 ? 0.0 : clamp(maskDepth / aa + .5, 0.0, 1.0) * field.a;
    float u = clamp(depth / height, 0.0, 1.0);
    float flatProfile = 1.0 - (u < 1.0 ? .2929 : 0.0);
    float rounded = sqrt(1.0 - (1.0 - u) * (1.0 - u));
    float profile = mix(flatProfile, rounded, curvature);
    float2 direction = float2(dot(field.yz, float2(angle.x, -angle.y)), dot(field.yz, angle.yx));
    float edge = clamp((q + height) / aa + .5, 0.0, 1.0);
    return float4(direction * (1.0 - profile) * edge, coverage, 1.0);
}
float4 nativeControlDisplacementMap(float4 field, float height, float curvature,
    float effectOffset, float maskOffset, float2 angle) {
    return nativeControlDisplacementMapForRaster(field, height, curvature, effectOffset, maskOffset, angle, 1.0);
}
float2 nativeControlMapAddress(float2 p, float4 map, float4 matrix, float2 offset) {
    float2 delta = map.rg - offset;
    return p + float2(dot(delta, matrix.xy), dot(delta, matrix.zw));
}

uniform float2 lensOrigin;
uniform float lensDensity;
uniform float lensScale;
uniform float lensSmall;
uniform float lensTab;
uniform float lensBlurScale;
uniform float lensRest;
uniform float lensMaterialProgress;
uniform float lensMaterialOpacity;
uniform float lensFullyResting;
uniform float lensHighlight;
uniform float lensHasContent;
uniform float lensHasBlur;
uniform float lensBelowAmount;
uniform float2 lensInner;
uniform float2 lensPortal;
uniform float2 lensAberration;
uniform float lensKeyThreshold;
uniform float lensRingOpacity;
uniform float lensShadowOpacity;
uniform float lensSliderShadow;
uniform float4 lensRestColor;
uniform float3 lensShadowColor;
uniform float4 lensIdleRow0;
uniform float4 lensIdleRow1;
uniform float4 lensIdleRow2;

float4 nativeControlOver(float4 source, float4 destination) {
    return source + destination * (1.0 - source.a);
}
float4 nativeControlIdentityCapture(float4 filtered, float4 captured) {
    if (captured.a >= 1.0 || lensMaterialOpacity >= 1.0) return filtered;
    // Captured filter output is an operator over its own input, not an independent
    // translucent image. Remove its neutral capture contribution as the material
    // approaches identity while retaining the complete optical/color difference.
    // This portable alpha extension preserves both the active endpoint and every
    // opaque-input composite: P' + C * (1-A') == P + C * (1-A).
    float alpha = filtered.a * lensMaterialOpacity;
    float3 straight = captured.rgb / max(captured.a, .000001);
    return float4(filtered.rgb - straight * (filtered.a - alpha), alpha);
}
float nativeControlCoverage(float3 field) {
    return nativeGlassShapeCoverage(float3(field.x / lensScale, field.yz), 1.0);
}

float4 nativeControlNatural(float2 p, bool blurred) {
    if (!blurred || lensHasBlur < .5) return nativeAtlasBilinear(lensOrigin + p, 0);
    // Keep the captured .25 transform, including odd extents. Do not stretch the
    // rounded quarter-sized texture to the padded full source's width or height.
    float4 rect = nativeAtlasRect(2);
    float2 pixel = clamp((lensOrigin + p) * lensBlurScale - .5, float2(0.0), rect.zw - 1.0);
    float2 index = floor(pixel);
    float2 t = pixel - index;
    return mix(mix(nativeAtlasTexel(index, rect), nativeAtlasTexel(index + float2(1.0, 0.0), rect), t.x),
        mix(nativeAtlasTexel(index + float2(0.0, 1.0), rect), nativeAtlasTexel(index + 1.0, rect), t.x), t.y);
}
float4 nativeControlMap(float3 field, float height) {
    return nativeControlDisplacementMapForRaster(float4(field, 1.0), max(height, .000001), 1.0,
        0.0, 0.0, float2(1.0, 0.0), lensScale);
}
float4 nativeControlMap(float2 p, float height) {
    return nativeControlMap(glassField(p, 0.0), height);
}
float4 nativeControlPortal(float2 p) {
    if (lensHasContent < .5) return float4(0.0);
    float4 map = nativeControlMap(p, 11.2 * lensDensity);
    float2 q = p + map.rg * (-17.5 * lensDensity * lensMaterialProgress);
    return nativeAtlasBilinear(lensOrigin + q, 1) * map.b;
}
float4 nativeControlBelow(float2 p, float3 field, float4 original) {
    float4 map = nativeControlMap(field, 36.0 * lensDensity);
    // SmallVariant's filter order is map -> Gaussian; the producer has already
    // warped its blurred plane. The Tab resting blur belongs to its separate body.
    float4 warped = lensSmall > .5 && lensHasBlur > .5 ? nativeControlNatural(p, true)
        : nativeControlNatural(p + map.rg * lensBelowAmount, false) * map.b;
    // The temporary below-glass backdrop is absent after native unlift cleanup.
    // Interpolate this optional stage's contribution without fading the complete lens.
    float4 natural = nativeControlOver(warped * lensMaterialOpacity, original);
    float coverage = nativeControlCoverage(field);
    float4 body = lensRestColor;
    if (lensTab > .5) {
        float4 source = nativeControlNatural(p, true);
        float4 straight = float4(source.rgb / max(source.a, .000001), 1.0);
        body = float4(dot(lensIdleRow0, straight), dot(lensIdleRow1, straight), dot(lensIdleRow2, straight), 1.0);
    }
    body = float4(body.rgb * body.a, body.a) * lensRest * coverage;
    return nativeControlOver(body, natural);
}
float4 nativeControlBelow(float2 p) {
    float3 field = glassField(p, 0.0);
    float4 original = nativeControlNatural(p, false);
    return nativeControlBelow(p, field, original);
}
float4 nativeControlClearContent(float2 p) {
    float coverage = nativeControlCoverage(glassField(p, 0.0));
    // Clear content is the source of the provider's color portal. The provider wrapper
    // has zPosition -1 and hides the ordinary Clear source layer; BG must not sample it.
    float radius = 3.0 * lensDensity * lensMaterialProgress;
    float inner = 0.0;
    if (radius > 0.0) {
        float innerD = glassField(p - float2(0.0, 7.0 * lensDensity * lensMaterialProgress), 0.0).x;
        inner = (1.0 - nativeGaussianTail(innerD / radius)) * .06 * lensMaterialOpacity * coverage;
    }
    return nativeControlOver(float4(0.0, 0.0, 0.0, inner), nativeControlPortal(p));
}
float3 nativeControlFace(float3 color) {
    float y = dot(color, float3(.2126, .7152, .0722));
    float black = .1 * lensSmall;
    return mix(color, color + black * (1.0 - y), lensMaterialOpacity);
}
float4 nativeControlBackground(float2 p, float3 f, float4 originalRaw) {
    float aa = max((abs(f.y) + abs(f.z)) * lensScale, .0001);
    float coverage = nativeControlCoverage(f);
    float strip = nativeHighlightStrip(-(f.x - (2.0 / 3.0) * lensDensity), lensDensity, .75, aa);
    float key = strip * (nativeHighlightAngular(f.y, lensKeyThreshold) + nativeHighlightAngular(-f.y, lensKeyThreshold))
        * lensMaterialOpacity;
    float shifted = glassField(p - float2(0.0, 8.0 * lensDensity), 0.0).x;
    float ring = clamp(nativeGaussianTail(shifted / (3.0 * lensDensity) * .7071067811865476)
        - nativeGaussianTail((shifted + 4.0 * lensDensity) / (3.0 * lensDensity) * .7071067811865476), 0.0, 1.0) * lensRingOpacity;
    float shadowD = glassField(p - float2(0.0, 7.0 * lensDensity), 0.0).x;
    float shadow = nativeGaussianTail(shadowD / (8.0 * lensDensity)) * lensShadowOpacity;
    if (coverage <= 0.0 && key <= .000001 && ring <= .000001 && shadow <= .000001) return float4(0.0);
    float3 original = originalRaw.rgb / max(originalRaw.a, .000001);
    float displacement = nativeGlassDisplacement(f.x, 1.0 / max(lensInner.x, .000001), lensInner.y);
    float4 sampled = nativeControlBelow(p + f.yz * displacement);
    float4 face = float4(nativeControlFace(sampled.rgb / max(sampled.a, .000001)), 1.0);
    // The style-0 shadow's tint-derived fill is supplied independently from the face.
    float4 shadowResult = float4(lensShadowColor * shadow, shadow);
    float4 covered = mix(shadowResult, face, coverage);
    covered.rgb *= 1.0 - ring;
    covered.a = covered.a * (1.0 - ring) + ring;
    float4 completed = nativeGlassBackgroundCompletion(covered, original, nativeControlFace(original), key,
        lensMaterialOpacity, -.3);
    return nativeControlIdentityCapture(completed, originalRaw);
}
float4 nativeControlAfterBackground(float2 p, float3 field, float4 background, float4 original) {
    float4 scene = nativeControlOver(background, original);
    float4 map = nativeControlMap(field, lensPortal.x);
    float2 q = lensPortal.y == 0.0 ? p : p + map.rg * lensPortal.y;
    float4 portal = nativeControlClearContent(q);
    // A nil control-displacement field is the identity endpoint. Its optional mask
    // must also become identity, rather than leaving an extra fixed AA multiplication.
    if (lensPortal.y != 0.0) portal *= mix(1.0, map.b, lensMaterialOpacity);
    return nativeControlOver(portal, scene);
}
float4 nativeControlBeforeForeground(float2 p) {
    float3 field = glassField(p, 0.0);
    float4 source = nativeControlNatural(p, false);
    float4 original = nativeControlBelow(p, field, source);
    return nativeControlAfterBackground(p, field, nativeControlBackground(p, field, original), original);
}
float4 nativeControlResting(float2 p) {
    float coverage = nativeControlCoverage(glassField(p, 0.0));
    float4 body = lensRestColor;
    if (lensTab > .5) {
        float4 sampled = nativeControlNatural(p, true);
        float4 straight = float4(sampled.rgb / max(sampled.a, .000001), 1.0);
        body = float4(dot(lensIdleRow0, straight), dot(lensIdleRow1, straight), dot(lensIdleRow2, straight), 1.0);
    }
    float4 result = float4(body.rgb * body.a, body.a) * coverage;
    if (lensHasContent > .5 && coverage > 0.0) {
        // UIKit removes its _Glass background at rest and sets wrapper displacement to0.
        // The selected source remains an ordinary, unwarped content view in this state.
        float4 selected = nativeAtlasBilinear(lensOrigin + p, 1) * coverage;
        result = nativeControlOver(selected, result);
    }
    if (lensSliderShadow > 0.0) {
        float d = glassField(p - float2(0.0, lensDensity), 0.0).x;
        float shadow = nativeGaussianTail(d / (5.0 * lensDensity)) * lensSliderShadow;
        result = nativeControlOver(result, float4(0.0, 0.0, 0.0, shadow));
    }
    return result;
}

float4 nativeControlSmallForeground(float4 source, float4 field, float4 edge, float pixelScale) {
    if (field.a < .001) return float4(0.0);
    float opacity = mix(edge.z, edge.w, clamp((field.x - edge.x) / (edge.y - edge.x), 0.0, 1.0));
    float attenuation = 1.0 - opacity;
    if (attenuation <= 0.0) return float4(0.0);
    float aa = max((abs(field.y) + abs(field.z)) * pixelScale, .0001);
    float coverage = clamp(.5 - field.x / aa, 0.0, 1.0) * field.a;
    float3 straight = source.rgb / max(source.a, .000001);
    // Preserve the seven-sample channel/alpha arithmetic at its shared-address limit.
    float3 color = float3((straight.r + straight.r * (2.0 / 3.0) + straight.r * (1.0 / 3.0)) * .5,
        (straight.g * (1.0 / 3.0) + straight.g * (2.0 / 3.0) + straight.g
            + straight.g * (2.0 / 3.0) + straight.g * (1.0 / 3.0)) / 3.0,
        (straight.b * (1.0 / 3.0) + straight.b * (2.0 / 3.0) + straight.b) * .5);
    float alpha = (source.a + source.a + source.a + source.a + source.a + source.a + source.a) / 7.0 * coverage;
    return float4(color * alpha, alpha) * attenuation;
}

uniform float2 lensOutputOrigin;
uniform float2 lensOutputSize;
half4 main(float2 coordinate) {
    if (coordinate.x < 0.0 || coordinate.y < 0.0 || coordinate.x >= lensOutputSize.x + lensOutputOrigin.x * 2.0
        || coordinate.y >= lensOutputSize.y + lensOutputOrigin.y * 2.0) return half4(0.0);
    float2 p = (coordinate - lensOutputOrigin) * lensScale;
    if (lensFullyResting > .5) return half4(nativeAtlasEncode(nativeControlResting(p)));
    float3 f = glassField(p, 0.0);
    float4 source = nativeControlNatural(p, false);
    float4 original = nativeControlBelow(p, f, source);
    float4 background = nativeControlBackground(p, f, original);
    float4 actual = nativeControlAfterBackground(p, f, background, original);

    float4 foreground = nativeControlSmallForeground(actual, float4(f, 1.0),
        float4(-size.y / 5.0, 0.0, 1.0, 0.0), lensScale);

    actual = nativeControlOver(nativeControlIdentityCapture(foreground, actual), actual);
    float coverage = nativeControlCoverage(f);
    float alpha = max(background.a, coverage);
    if (source.a < 1.0) {
        // Convert the fully composed scene back to an operator over this source.
        // Keep the opaque path unchanged; its source alpha cannot recover relative alpha.
        alpha = (actual.a - source.a) / (1.0 - source.a);
    }
    if (alpha <= .000001 && lensSliderShadow <= 0.0) return half4(0.0);
    float4 result = float4(actual.rgb - source.rgb * (1.0 - alpha), alpha);
    float3 fieldFull = float3(f.x / lensScale, f.yz);
    float mask = nativeCasdfHighlightCoverage(fieldFull.x, fieldFull.yz,
        lensDensity / lensScale, 0.0, .75) * lensHighlight;
    if (mask > 0.0) result = nativeControlOver(nativeVibrantColorMatrix(float4(0.0, 0.0, 0.0, mask), actual), result);
    if (lensSliderShadow > 0.0) {
        float d = glassField(p - float2(0.0, lensDensity), 0.0).x;
        float shadow = nativeGaussianTail(d / (5.0 * lensDensity)) * lensSliderShadow;
        result = nativeControlOver(result, float4(0.0, 0.0, 0.0, shadow));
    }
    return half4(nativeAtlasEncodeRelative(result, source));
}
